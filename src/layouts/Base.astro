---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/frank-ruhl-libre';
import '@fontsource-variable/assistant';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import portrait from '../assets/photos/portrait.jpg';

export type Lang = 'en' | 'he' | 'pt';
interface Props { lang: Lang; title: string; description: string }
const { lang, title, description } = Astro.props;

const paths: Record<Lang, string> = { en: '/', he: '/he/', pt: '/pt/' };
const site = 'https://rememberranani.com';
const og = await getImage({ src: portrait, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogLocale = { en: 'en_US', he: 'he_IL', pt: 'pt_BR' }[lang];
---
<!doctype html>
<html lang={lang} dir={lang === 'he' ? 'rtl' : 'ltr'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#22314F" />
  <link rel="canonical" href={site + paths[lang]} />
  {(['en', 'he', 'pt'] as Lang[]).map((l) => <link rel="alternate" hreflang={l} href={site + paths[l]} />)}
  <link rel="alternate" hreflang="x-default" href={site + '/'} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={site + paths[lang]} />
  <meta property="og:image" content={site + og.src} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={ogLocale} />
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  {lang === 'en' && (
    <script is:inline>
      // First visit to "/": follow a saved choice, else the browser's language
      try {
        var saved = localStorage.getItem('lang');
        var pref = (saved || (navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
        if (pref.indexOf('he') === 0 || pref.indexOf('iw') === 0) location.replace('/he/');
        else if (pref.indexOf('pt') === 0) location.replace('/pt/');
      } catch (e) {}
    </script>
  )}
</head>
<body>
  <slot />
</body>
</html>
